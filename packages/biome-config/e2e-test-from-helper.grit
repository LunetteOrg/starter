// An e2e takes `test` from @lntt/test-utils/playwright, never from @playwright/test:
// that `test`'s context fixture is what E2E_HYDRATION_DELAY_MS slows down, so a spec
// on the runner's own `test` would pass a delayed-hydration run without being delayed.
//
// Flags an import from @playwright/test that brings in `test`: by name (`{ test }`),
// renamed (`{ test as base }`, `{ default as base }`), as the default export, alone or
// next to named imports, or through a namespace. Flags the same forms re-exported by a
// fixtures file: `export { test }`, `export { default }`, `export *`, `export * as`.
// `expect`, `devices` and types still come from @playwright/test; `import type` and
// `export type` are left alone. A regex here matches the whole node, not a part of it.
or {
  JsImport() as $statement where {
    $statement <: contains `"@playwright/test"`,
    $statement <: not r"(?s)import\s+type\b.*",
    $statement <: contains or {
      JsShorthandNamedImportSpecifier() as $name where { $name <: r"test" },
      JsNamedImportSpecifier() as $name where { $name <: r"(?s)(?:test|default)\s+as\s.*" },
      JsImportDefaultClause(),
      JsImportCombinedClause(),
      JsImportNamespaceClause()
    }
  },
  JsExport() as $statement where {
    $statement <: contains `"@playwright/test"`,
    $statement <: not r"(?s)export\s+type\b.*",
    $statement <: contains or {
      JsExportFromClause(),
      JsExportNamedFromSpecifier() as $name where { $name <: r"(?s)(?:test|default)(?:\s+as\s.*)?" }
    }
  }
} where {
  register_diagnostic(
    span = $statement,
    message = "An e2e imports `test` from @lntt/test-utils/playwright, not from @playwright/test: its context fixture is what E2E_HYDRATION_DELAY_MS delays. `expect`, `devices` and types still come from @playwright/test. See https://github.com/LunetteOrg/starter/blob/main/docs/adr/e2e-helpers.md"
  )
}
