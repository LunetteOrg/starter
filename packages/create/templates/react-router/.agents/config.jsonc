{
  "$schema": "https://raw.githubusercontent.com/LunetteOrg/starter/main/packages/lntt/schema/config.schema.json",

  // Where this project came from: the Lunette template and the @lntt/create version
  // that scaffolded it. Written once by the CLI; a template update is computed from it.
  "lunette": {
    "template": "react-router",
    "version": "__LNTT_CREATE_VERSION__"
  },

  // Friction that comes from Lunette itself (lntt, a shared skill, the template) starts
  // with [LunetteOrg/starter] in the retrospective blocks, and the retrospective skill
  // reports it there with lntt issue, on the operator's approval.
  "cycle": {
    "retrospective": {
      "upstream": { "repository": "LunetteOrg/starter" }
    }
  }
}
