{
  "$schema": "https://raw.githubusercontent.com/LunetteOrg/starter/main/packages/lntt/schema/config.schema.json",

  // Where this project came from: the Lunette template and the @lntt/create version
  // that scaffolded it. Written once by the CLI; a template update is computed from it.
  "lunette": {
    "template": "react-router",
    "version": "__LNTT_CREATE_VERSION__"
  },

  // Where the project stands. In development lntt review does not ask for what only
  // protects users and data the project does not have yet. Switch it to "production"
  // when the first release reaches production, a beta with real users included:
  // lntt set project.phase '"production"'
  "project": {
    "phase": "development"
  },

  // Friction that comes from Lunette itself (lntt, a shared skill, the template) starts
  // with [upstream:LunetteOrg/starter] in the retrospective blocks, and the retrospective
  // skill reports it there with lntt issue, on the operator's approval.
  "cycle": {
    "retrospective": {
      "upstream": { "repository": "LunetteOrg/starter" }
    }
  }
}
