{
  // pelion's process (DiscenTech/pelion, main at e06676ff) as one configuration: values from
  // AGENTS.md, CONTRIBUTING.md, docs/adr (ciclo-di-lavoro.md, ci.md), .claude/skills, .github
  // and the live board. pelion has no .agents/config of its own. The handles are
  // placeholders, not the members' real ones.
  "recording": {
    "language": "it",
    "logs": {
      "adr": { "path": "docs/adr", "index": "docs/adr/README.md", "template": "docs/adr/template.md" },
      "product": {
        "path": "docs/product/decisions",
        "index": "docs/product/README.md",
        "template": "docs/product/decisions/template.md"
      }
    }
  },
  "board": {
    "project": { "owner": "DiscenTech", "ownerType": "organization", "number": 1, "title": "Discentis Tech Projects" },
    "issueTypes": { "parents": ["Feature"], "children": ["Task", "Bug"] },
    "subIssues": true,
    "milestones": true,
    "blockedBy": true,
    "fields": {
      "status": {
        "name": "Status",
        "type": "singleSelect",
        // Discussing holds an open decision; To release, a change squashed into release/N.
        "options": ["Todo", "Discussing", "Ready", "In progress", "To review", "To release", "Done"],
        "initial": "Todo",
        "ready": "Ready",
        "inProgress": "In progress",
        "inReview": "To review",
        "done": "Done"
      },
      "priority": { "name": "Priority", "type": "singleSelect", "options": ["P0", "P1", "P2", "P3", "Not now"] },
      "size": { "name": "Size", "type": "singleSelect", "options": ["XS", "S", "M", "L", "XL"], "on": "children" },
      // The live field and docs/adr/ciclo-di-lavoro.md; the skills still list three.
      "horizon": {
        "name": "Scope",
        "type": "singleSelect",
        "options": ["Now", "Next", "Later", "Not now", "Permanent"],
        "on": "parents"
      },
      // On every Feature; Debito stays out of the roadmap and of velocity.
      "classe": {
        "name": "Classe",
        "type": "singleSelect",
        "options": ["Prodotto", "Piattaforma", "Debito"],
        "on": "parents"
      },
      // set when scheduling, never on a Feature
      "iteration": { "name": "Iteration", "type": "iteration", "on": "children" },
      "startDate": { "name": "Start Date", "type": "date", "on": "parents" },
      "targetDate": { "name": "End Date", "type": "date", "on": "parents" }
    },
    "tracks": {
      "from": ["apps/*"],
      // Dependabot's labels (dependencies, github_actions, javascript) are not tracks.
      "labels": {
        "community": { "paths": ["apps/community"], "description": "apps/community — l'app pubblica" },
        "admin": { "paths": ["apps/admin"], "description": "apps/admin — backoffice authoring" },
        // Storybook, packages/ui and the tokens (.claude/skills/party/SKILL.md).
        "design-system": {
          "paths": ["apps/design-system", "packages/ui", "packages/ui-tokens"],
          "description": "packages/ui e ui-tokens — il design system"
        },
        "infrastructure": { "description": "CI, deploy, tooling — cross-cutting, non di un singolo app" },
        "marketing": {
          "description": "Tag manager, pixel, conversioni — lavoro sul container/agenzia, non codice app"
        },
        "moodle": { "description": "Piattaforma della formazione: Moodle in casa" },
        "prodotto": { "description": "Decisioni di prodotto (PDR), analisi e ADR che ne discendono" },
        "documentation": { "description": "Improvements or additions to documentation" },
        "security": { "description": "Finding delle scansioni di sicurezza (Semgrep, pnpm audit) e il loro triage" },
        // The levers: a dimension an issue can take several values of, so labels and not a field.
        "leva:acquisizione": { "description": "Serve l'asse Acquisizione (iscritti esterni)" },
        "leva:stickiness": { "description": "Serve l'asse Stickiness (membri di ritorno per settimana)" },
        "leva:b2b": { "description": "Leva: vendita e relazione con istituzioni, non con il singolo docente" }
      }
    }
  },
  "ci": {
    "providers": ["circleci", "github-actions"],
    "drafts": false // a pull request goes ready after a green pnpm ci:local --e2e
  },
  "delivery": {
    // test and ci are used besides the documented types (ci on 11 branches, the latest
    // 2026-10-15); the middle segment is the issue number or no-story.
    "branches": { "types": ["feat", "fix", "chore", "refactor", "docs", "test", "ci"] },
    "candidate": {
      "base": "main",
      "prefix": "release/",
      "hotfix": { "prefix": "hotfix/", "label": "hotfix" }, // the label does not exist yet
      "status": { "inRelease": "To release", "done": "Done" }
    },
    "commits": {
      "language": "it",
      // No longTrailers: commitlint is the plain config-conventional, so a Retro line over
      // 100 characters is rejected.
      "trailers": { "Retro": "a signal for the retrospective, or none; absorbed into the pull request body" }
    },
    "pullRequest": {
      "language": "it", // the prose; the template's headings and labels are English
      "template": ".github/pull_request_template.md",
      "closing": ["Closes", "Fixes", "Resolves"], // "Chiude #N" closes nothing
      "outcome": { "done": "— done", "notApplicable": "— not applicable:" },
      "retrospective": {
        "heading": "🔁 Retrospective",
        "lines": [
          "Friction",
          "To automate (hook/skill/agent)",
          "Rule rediscovered (→ ADR/AGENTS.md)",
          "Rework cause",
          "Unstable tests"
        ],
        "none": "none"
      }
    }
  },
  "cycle": {
    "iteration": { "days": 14, "startDay": 1 },
    "retrospective": {
      "target": { "kind": "issue", "title": "Retrospective — {window}" },
      // The same test or cause in two pull requests: a targeted review of the suite (DiscenTech/pelion#1132).
      "targetedReview": { "line": "Unstable tests", "minPullRequests": 2 }
    }
  },
  // No spikes: a spike is a sub-issue, with a written decision as its deliverable, under a Feature in Discussing.
  "spaces": {
    "reference": { "path": "reference/", "description": "Legacy and raw prototypes, read-only and quarantined" },
    "prototypes": { "path": "apps/design-system/src/Explorations/", "description": "Storybook explorations" },
    "notes": { "path": "appunti/", "tracked": false }
  },
  "team": {
    "language": "it",
    // Marketing, content and design people work in the repository too.
    "members": {
      "maintainer-1": { "role": "maintainer", "owns": ["*"] }, // .github/CODEOWNERS: the code owner of every path
      "member-1": {},
      "member-2": {},
      "member-3": {}
    }
  }
}
