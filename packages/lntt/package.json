{
  "name": "@lntt/lntt",
  "version": "0.6.2",
  "description": "The lntt command: a Lunette project's configuration and operator profile, the managed block of AGENTS.md, the checks and reviews of a change, and its CI run on the local machine with the candidate automation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LunetteOrg/starter.git",
    "directory": "packages/lntt"
  },
  "homepage": "https://github.com/LunetteOrg/starter/tree/main/packages/lntt#readme",
  "bugs": "https://github.com/LunetteOrg/starter/issues",
  "exports": {
    ".": "./src/index.ts",
    "./ci": "./src/ci/index.ts",
    "./schema.json": "./schema/config.schema.json",
    "./operator-schema.json": "./schema/operator.schema.json"
  },
  "bin": {
    "lntt": "bin/lntt.ts"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.cpSync('agents','dist/agents',{recursive:true});fs.cpSync('skills','dist/skills',{recursive:true})\"",
    "prepack": "pnpm run build",
    "test": "node --test test/*.test.ts test/ci/*.test.ts",
    "test:upstream": "node --test test/upstream-orca.test.ts test/upstream-herdr.test.ts test/upstream-claude.test.ts test/upstream-opencode.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "lntt": "dist/bin/lntt.js"
    },
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./ci": {
        "types": "./dist/src/ci/index.d.ts",
        "default": "./dist/src/ci/index.js"
      },
      "./schema.json": "./schema/config.schema.json",
      "./operator-schema.json": "./schema/operator.schema.json"
    }
  },
  "dependencies": {
    "@actions/expressions": "0.3.61",
    "@actions/workflow-parser": "0.3.61",
    "ajv": "^8.20.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@commitlint/config-conventional": "^21.2.0"
  },
  "peerDependenciesMeta": {
    "@commitlint/config-conventional": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/lint": "^21.2.0",
    "@commitlint/load": "^21.2.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
