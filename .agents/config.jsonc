{
  "$schema": "../packages/project-config/schema/config.schema.json",

  // How this repo records its decisions. A template's own logs live inside the
  // template (packages/create/templates/<framework>/docs/adr/) and travel with the
  // projects scaffolded from it; they are not listed here.
  "recording": {
    "language": "en",
    "logs": {
      "adr": {
        "path": "docs/adr",
        "index": "docs/adr/README.md",
        "template": "docs/adr/template.md",
        "scope": "Decisions about the templates system: the CLI, the template model, the scaffolding contract."
      },
      "process": {
        "path": "docs/process",
        "index": "docs/process/README.md",
        "scope": "How work is done in this repo: mechanisms and reasons a configuration value cannot express. Never technical decisions."
      }
    }
  },
  // What pnpm ci:local leaves to the cloud (docs/process/ci.md).
  "ci": {
    "local": {
      "cloudOnly": {
        "release.yml": "publishes @lntt/create to npm with the OIDC token of a published GitHub Release"
      }
    }
  },
  "delivery": {
    "commits": {
      "language": "en",
      "longTrailers": [
        "Retro"
      ]
    }
  }
}
