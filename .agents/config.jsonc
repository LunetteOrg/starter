{
  "$schema": "../packages/lntt/schema/config.schema.json",

  // How this repo records its decisions. A template's own logs live inside the
  // template (packages/create/templates/<framework>/docs/adr/) and travel with the
  // projects scaffolded from it; they are not listed here.
  "recording": {
    "language": "en",
    "logs": {
      "adr": {
        "path": "docs/adr",
        "index": "docs/adr/README.md",
        "template": "docs/adr/template.md",
        "scope": "Decisions about the templates system: the CLI, the template model, the scaffolding contract."
      },
      "process": {
        "path": "docs/process",
        "index": "docs/process/README.md",
        "scope": "How work is done in this repo: mechanisms and reasons a configuration value cannot express. Never technical decisions."
      }
    },
    // What ships to other projects cites their records, not this repo's: lntt check
    // decisions does not resolve the paths these files name.
    "externalReferences": {
      "packages/biome-config/**": "lint rules every project installs, citing that project's ADRs",
      "packages/test-utils/**": "test helpers every project installs, citing that project's ADRs",
      "packages/lntt/schema/**": "the schema of every project's configuration, citing that project's process pages",
      "packages/lntt/test/**": "tests that name the records of their fixtures",
      "packages/lntt/skills/**": "the shared skills' guides, printed in every project by lntt guide, citing that project's records"
    }
  },
  // The test levels, lowest first (lntt check tests): every test file sits at exactly one.
  "tests": {
    // Named like tests, read by tests: not tests themselves.
    "ignore": ["**/__fixtures__/**"],
    // scaffold-smoke's run() throws when a command fails: that is its assertion.
    "assertions": ["run"],
    "levels": [
      {
        "name": "unit",
        "files": ["packages/test-utils/src/**/*.spec.ts"],
        "environment": "vitest, node",
        "cwd": "packages/test-utils",
        "run": "pnpm exec vitest run {files}"
      },
      {
        "name": "cli",
        "files": [
          "packages/{biome-config,lntt,stylelint-config,typescript-config,playwright-config}/test/**/*.test.ts",
          "scripts/*.test.mts",
          "plugins/*/hooks/*.test.mjs"
        ],
        "exclude": ["**/fixtures/**"],
        "environment": "node:test, the CLI against fixture repositories in a temp dir",
        "run": "node --test {files}",
        "coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination={out}/lcov.info {files}"
      },
      {
        "name": "scaffold",
        "files": ["packages/create/test/*.test.ts"],
        "environment": "node:test, each template scaffolded into a temp dir",
        "cwd": "packages/create",
        "run": "node --test {files}"
      },
      {
        "name": "integration",
        "files": ["packages/test-utils/src/**/*.test.ts"],
        "environment": "vitest, node and a Postgres in Docker",
        "harness": ["hasTestDatabase"],
        "cwd": "packages/test-utils",
        "run": "pnpm exec vitest run {files}"
      }
    ]
  },
  // What pnpm ci:local leaves to the cloud (docs/process/ci.md).
  "ci": {
    "local": {
      "cloudOnly": {
        "release.yml": "publishes the @lntt packages to npm with the OIDC token of a published GitHub Release",
        "candidate.yml": "moves pull requests and edits the candidate with the GitHub App's token"
      }
    }
  },
  // The board (docs/process/board.md): the lunette roadmap Project, shared with
  // LunetteOrg's other repositories. Issue types belong to the organization.
  "board": {
    "github": {
      "project": { "owner": "LunetteOrg", "ownerType": "organization", "number": 1, "title": "lunette roadmap" },
      // docs/process/board.md says what each view is for; the groupings are set in the UI.
      "views": [
        { "name": "All", "layout": "table", "filter": "" },
        { "name": "Board", "layout": "board", "filter": "is:open", "columns": "Status" },
        { "name": "Horizon", "layout": "table", "filter": "is:open type:Feature,Platform,Debt,Ongoing", "groupBy": "Horizon" },
        { "name": "Release", "layout": "table", "filter": "is:open", "groupBy": "Milestone" }
      ]
    },
    // Task is the work under a parent; standing alone, an issue takes its kind of work
    // (docs/process/board.md). Only Ongoing never closes: a debt closes when paid.
    "issueTypes": {
      "parents": ["Feature", "Platform", "Debt", "Ongoing"],
      "children": ["Task", "Bug"],
      "permanent": ["Ongoing"],
      // Written on the organization's types by lntt board sync.
      "descriptions": {
        "Feature": "Functionality for the people who use the product",
        "Bug": "Something that does not work as it should",
        "Platform": "Infrastructure and tools the product runs on",
        "Debt": "Technical debt to pay back",
        "Ongoing": "Recurring work with no end: maintenance, support"
      }
    },
    // A parent's work is its sub-issues, and the Project adds them on its own.
    "subIssues": true,
    // The milestones add-on: a milestone is a release, one per version (vX.Y.Z). No
    // iterations: the starter plans on the horizon and the releases.
    "milestones": true,
    // A hard dependency is a blocked-by, so "unblocked work" is a filter.
    "blockedBy": true,
    "fields": {
      "status": {
        "name": "Status",
        "type": "singleSelect",
        // In release: squashed into the open candidate, set by its automation (delivery).
        "options": ["Todo", "Ready", "In progress", "In review", "In release", "Done"]
      },
      "priority": { "name": "Priority", "type": "singleSelect", "options": ["P0", "P1", "P2", "P3"] },
      // Read by coordinator.models.children, on whichever issue a child works.
      // Colors run green to red as the work grows: XL is the one to split.
      "size": {
        "name": "Size",
        "type": "singleSelect",
        "options": ["XS", "S", "M", "L", "XL"],
        "colors": { "XS": "GREEN", "S": "BLUE", "M": "YELLOW", "L": "ORANGE", "XL": "RED" }
      },
      "horizon": {
        "name": "Horizon",
        "type": "singleSelect",
        "options": ["Now", "Next", "Later", "Backlog"],
        "on": "parents",
        "colors": { "Now": "GREEN", "Next": "BLUE", "Later": "YELLOW", "Backlog": "GRAY" }
      }
    }
  },
  // Coordinator mode (docs/adr/coordinator-mode.md). The coordinator's work is mostly
  // mechanical (starting children, reading their reports), so it runs on sonnet; a child
  // by the Size of its issue, the top model for M and up.
  "coordinator": {
    "gate": "propose",
    "models": {
      "coordinator": { "kind": "claude", "model": "sonnet" },
      "children": {
        "XS": { "kind": "claude", "model": "sonnet" },
        "S": { "kind": "claude", "model": "sonnet" },
        "M": { "kind": "claude", "model": "opus" },
        "L": { "kind": "claude", "model": "opus" },
        "XL": { "kind": "claude", "model": "opus" }
      }
    }
  },
  "delivery": {
    // Pull requests into main collect on candidate/<N>, which reaches main with a
    // rebase merge (docs/process/delivery.md).
    "candidate": {
      "base": "main",
      "prefix": "candidate/",
      "hotfix": { "prefix": "hotfix/", "label": "hotfix" }
    },
    // Who reviews before a pull request is marked ready (lntt review): the code lens
    // and the verifiers on more than one provider, so a blind spot of one model is
    // not the review's; the verifiers try to refute every blocker and warning. The
    // free opencode models are optional: they time out under load, and a round does
    // not wait on them.
    "review": {
      "reviewers": {
        // haiku: lntt check decisions does the structural checks, the lens only judges
        "decisions": { "with": [{ "kind": "claude", "model": "haiku" }] },
        "code": {
          "with": [
            { "kind": "claude", "model": "sonnet" },
            { "kind": "opencode", "model": "opencode/deepseek-v4.1-flash-free", "optional": true }
          ]
        },
        "tests": { "with": [{ "kind": "claude", "model": "sonnet" }] }
      },
      "verify": {
        "with": [
          { "kind": "claude", "model": "sonnet" },
          { "kind": "opencode", "model": "opencode/glm-5.3-flash-free", "optional": true }
        ]
      }
    },
    "commits": {
      "language": "en",
      "longTrailers": [
        "Retro"
      ]
    },
    // The body of a pull request: its sections are in docs/process/delivery.md, the
    // retrospective block is filled by the retrospective skill and checked by
    // lntt check body. The review's cost is a line of its own: the harvest weighs it.
    "pullRequest": {
      "language": "en",
      "template": ".github/pull_request_template.md",
      "retrospective": {
        "heading": "🔁 Retrospective",
        "lines": [
          "Friction",
          "To automate (hook/skill/agent)",
          "Rule rediscovered (→ ADR/AGENTS.md)",
          "Rework cause",
          "Review cost (rounds, tokens, USD)"
        ],
        "none": "none"
      }
    }
  },
  // The harvest of the retrospective blocks, at the end of a theme or a release
  // (docs/process/delivery.md): a Discussion, so the adopted proposals are issues and
  // the retrospective itself is not one.
  "cycle": {
    "retrospective": {
      "target": {
        "kind": "discussion",
        "category": "Ideas",
        "title": "Retrospective — {window}",
        "targetedTitle": "Targeted retrospective — {subject}"
      },
      // Friction that comes from Lunette itself starts with [LunetteOrg/starter] in the
      // retrospective blocks; lntt issue reports it here. This repo is its own upstream.
      "upstream": { "repository": "LunetteOrg/starter" }
    }
  }
}
